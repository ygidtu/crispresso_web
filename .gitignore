# ---- Python / uv ----
.venv/
__pycache__/
*.pyc

# ---- Frontend (Vite) ----
node_modules/
frontend/dist/

# ---- 运行期产物 ----
jobs/
uploads/
oss_tasks/
*.log
# SQLite 持久化（任务/日志元数据，运行期生成，绝不入库）
*.db
*.db-wal
*.db-shm

# ---- 密钥（绝不入库）----
.secrets/

# ---- 本机配置（含 SMTP 授权码 / 内网 IP 白名单，绝不入库；模板见 config.example.ini）----
config.ini

# ---- 其他运行期产物 ----
cache/
logs/
